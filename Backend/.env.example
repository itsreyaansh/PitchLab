# Copy to .env. Demo mode works immediately without external calls.
API_AI_PROVIDER=demo
# Switch to openai_compatible and set your provider's URL and model.
API_AI_BASE_URL=https://api.openai.com/v1
API_AI_MODEL=
API_AI_API_KEY=
# Turn off JSON mode if the provider does not support response_format.
API_AI_JSON_MODE=true
API_AI_TOKEN_PARAMETER=max_tokens
API_TTS_ENABLED=false
API_TTS_BASE_URL=https://api.openai.com/v1
API_TTS_API_KEY=
API_TTS_MODEL=tts-1
API_TTS_VOICE=alloy
API_TTS_TIMEOUT_SECONDS=30
API_TTS_OUTPUT_DIR=generated_audio
API_WEB_ACCESS_ENABLED=true
# Default uses DuckDuckGo's public JSON endpoint. You can replace this with a compatible endpoint.
API_WEB_SEARCH_URL=https://api.duckduckgo.com/
API_WEB_TIMEOUT_SECONDS=5
API_MAX_CONCURRENT_AI_CALLS=4
# Keep these secrets on the backend; never expose the admin key to browsers.
API_ADMIN_KEY=
API_CLIENT_KEY=
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
API_MAX_REQUEST_BYTES=262144
API_LOG_LEVEL=INFO
API_DOCS_ENABLED=true
# Optional seed file, used only when the database has no configuration yet.
# API_CONFIG_FILE=simulation.example.json
# API_DATABASE_URL=sqlite:///./shark_tank.db
